# Dollar amounts are compiled into the static export.
# Production default: leave this unset, or set it to false.
# Preview builds (local screenshots, CI, Cloudflare Pages preview): true
NEXT_PUBLIC_SHOW_PRICES=false

# preview or production. Unset means production.
# Preview builds are always noindex, even if NEXT_PUBLIC_ALLOW_INDEX=true.
NEXT_PUBLIC_SITE_BUILD=production

# Production indexing stays off until launch.
# Set to true only on a production build when the site should be indexed.
NEXT_PUBLIC_ALLOW_INDEX=false
