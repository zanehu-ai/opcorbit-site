{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/dev", "destination": "/", "permanent": true },
    { "source": "/dev/", "destination": "/", "permanent": true },
    { "source": "/outbound", "destination": "/", "permanent": true },
    { "source": "/outbound/", "destination": "/", "permanent": true },
    { "source": "/creative", "destination": "/", "permanent": true },
    { "source": "/creative/", "destination": "/", "permanent": true },
    { "source": "/support", "destination": "/", "permanent": true },
    { "source": "/support/", "destination": "/", "permanent": true },
    { "source": "/terms-of-service", "destination": "/terms/", "permanent": true },
    { "source": "/terms-of-service/", "destination": "/terms/", "permanent": true },
    { "source": "/privacy-policy", "destination": "/privacy/", "permanent": true },
    { "source": "/privacy-policy/", "destination": "/privacy/", "permanent": true },
    { "source": "/refund-policy", "destination": "/refund/", "permanent": true },
    { "source": "/refund-policy/", "destination": "/refund/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
